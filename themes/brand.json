    "mist": {
      "en": "Sage",
      "nl": "Salie"
    }
  },
  "brandColors": [
    "#254d38",
    "#8a6209",
    "#4f8f6b",
    "#c9931a"
  ],
  "gradient": {
    "enabled": false
  },
  "slideBackgrounds": [
    {
      "id": "calm",
      "label": "Calm",
      "value": "radial-gradient(circle at 62% 18%, rgba(45, 107, 74, 0.55) 0%, rgba(45, 107, 74, 0.18) 38%, rgba(0, 0, 0, 0) 72%), radial-gradient(circle at 12% 88%, rgba(184, 134, 15, 0.32) 0%, rgba(184, 134, 15, 0.08) 44%, rgba(0, 0, 0, 0) 78%), #10281b",
      "textColor": "#ffffff",
      "textColorMuted": "rgba(255, 255, 255, 0.72)"
    }
  ],
  "cssVars": {
    "--t-slide-bg-lime": "#f5f3ef",
    "--t-slide-bg-mist": "#e6efe8",
    "--t-slide-bg-dark": "#10281b",
