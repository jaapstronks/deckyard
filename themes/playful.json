    "--t-radius-lg": "32px",
    "--t-font-heading": "'Poppins', ui-sans-serif, system-ui, -apple-system, sans-serif",
    "--t-font-body": "'Nunito', ui-sans-serif, system-ui, -apple-system, sans-serif",
    "--t-font-caption": "var(--t-font-body)",
    "--t-font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
