{
  "id": "playful",
  "label": "Sunset",
  "defaultTitleSlide": "title-slide",
  "titleLayout": "center",
  "assets": {
    "logo": "/assets/images/logo-placeholder.svg",
    "logoAlt": "Your logo",
    "payoffLogo": "/assets/images/logo-placeholder.svg",
    "payoffAlt": "Your logo"
  },
  "textColorLight": "#ffffff",
  "textColorDark": "#431407",
  "backgroundLabels": {
    "lime": {
      "en": "Cream",
      "nl": "Crème"
    },
    "mist": {
      "en": "Blossom",
      "nl": "Bloesem"
    }
  },
  "brandColors": [
    "#db2777",
    "#ea580c",
    "#f59e0b",
    "#fb7185"
  ],
  "textSwatches": [
    {
      "id": "brand-1",
      "label": {
        "en": "Pink",
        "nl": "Roze"
      }
    },
    {
      "id": "brand-2",
      "label": {
        "en": "Rust",
        "nl": "Roest"
      }
    }
  ],
  "gradient": {
    "enabled": false
  },
  "cssVars": {
    "--t-slide-bg-lime": "#fffbf5",
    "--t-slide-bg-mist": "#ffe4e6",
    "--t-slide-bg-dark": "#7c2d12",
