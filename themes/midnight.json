{
  "id": "midnight",
  "label": "Midnight",
  "defaultTitleSlide": "title-slide",
  "titleLayout": "center",
  "assets": {
    "logo": "/assets/images/logo-placeholder.svg",
    "logoAlt": "Your logo",
    "payoffLogo": "/assets/images/logo-placeholder.svg",
    "payoffAlt": "Your logo"
  },
  "textColorLight": "#fafafa",
  "textColorDark": "#1c1917",
  "backgroundLabels": {
    "lime": {
      "en": "Ink",
      "nl": "Inkt"
    },
    "mist": {
      "en": "Charcoal",
      "nl": "Antraciet"
    }
  },
  "brandColors": ["#38bdf8", "#818cf8", "#f472b6", "#fbbf24"],
  "gradient": {
    "enabled": true
  },
  "cssVars": {
    "--t-slide-bg-lime": "#18181b",
    "--t-slide-bg-mist": "#27272a",
    "--t-slide-bg-dark": "#09090b",
    "--t-color-background": "#09090b",
    "--t-color-text": "#fafafa",
    "--t-color-text-muted": "rgba(250, 250, 250, 0.64)",
    "--t-color-accent": "#38bdf8",
    "--t-color-accent-on-dark": "#7dd3fc",
    "--t-slide-bg-dark-text": "#fafafa",
    "--t-radius": "12px",
    "--t-radius-sm": "8px",
    "--t-radius-lg": "18px",
    "--t-font-heading": "'Space Grotesk', ui-sans-serif, system-ui, -apple-system, sans-serif",
    "--t-font-body": "'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif",
    "--t-font-caption": "var(--t-font-body)",
    "--t-font-mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
    "--t-heading-transform": "uppercase",
    "--t-heading-weight": "500",
    "--t-color-surface-raised": "#f4f4f5",
    "--t-chart-0": "#38bdf8",
    "--t-chart-1": "#818cf8",
    "--t-chart-2": "#f472b6",
    "--t-chart-3": "#fbbf24",
    "--t-chart-4": "#34d399",
    "--t-chart-5": "#fafafa",
    "--t-chart-6": "#a1a1aa",
    "--t-chart-7": "#c084fc",
    "--t-logo-url": "url('/assets/images/logo-placeholder.svg')"
  },
  "embedFonts": [
    {
      "family": "Space Grotesk",
      "path": "assets/fonts/google/space-grotesk/space-grotesk-400-latin.woff2",
      "weight": "400 700",
      "style": "normal",
      "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
    },
