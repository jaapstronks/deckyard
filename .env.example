# Deckyard Environment Variables
# Copy this file to .env and fill in your values
#
# Boolean flags share one vocabulary: 1/true/yes/on means on, 0/false/no/off
# means off (any case). Anything else — unset, blank, or a typo — keeps the
# flag's documented default, so a misspelled value can never flip a flag to
# the unsafe side. Numeric knobs fall back to their default when the value is
# not a number or out of the documented range.

# ============================================
# Server
# ============================================
# PORT=4177
# DEFAULT_THEME=brand
# Comma-separated allowlist of theme ids that may be picked. Unset or empty
# means every theme is offered. The Settings → Themes allowlist wins when it is
# set, same precedence as DEFAULT_THEME; this is the fork seam for shipping the
# allowlist as configuration instead of clicking it per instance. The default
# theme, and the theme a deck already uses, stay available regardless.
# ENABLED_THEMES=brand,editorial
# Max accepted JSON request-body size in bytes (default 25 MB). Bounds memory
# use against oversized bodies; raise it only if you save very large decks.
# MAX_REQUEST_BODY_BYTES=26214400
# Bind address for the HTTP server. Default 127.0.0.1; set 0.0.0.0 to listen
# on all interfaces (e.g. inside a container).
# HOST=127.0.0.1
# Comma-separated list of host values allowed for URL generation/validation.
# Empty or unset means any host is allowed.
# ALLOWED_HOSTS=slides.yourdomain.com
# Data directory (settings, working files). Absolute path, or relative to the
# repo root. Default: server/data (server/data-sandbox in sandbox mode).
# DATA_DIR=server/data
# Uploads directory for locally stored media. Absolute path, or relative to
# the repo root. Default: server/uploads (server/uploads-sandbox in sandbox mode).
# UPLOADS_DIR=server/uploads

# Debug logging. DEBUG_LOG enables server-side debug logs on stdout
# (1/true/yes/on). DEBUG_LOG_CLIENT additionally ships debug logs to the
# browser console — DEBUG_LOG already implies it; set only DEBUG_LOG_CLIENT to
# debug the client without spamming server logs. Both default: off.
# DEBUG_LOG=false
# DEBUG_LOG_CLIENT=false

# Branding / white-label (optional)
# APP_NAME sets the product name in the browser tab title, the logo alt text,
# email sender name, and social/OG cards. Defaults to "Deckyard".
# APP_NAME=Deckyard
# HELP_URL adds a "Help & docs" link to the user menu. Must be an absolute
# http(s) URL; when unset the link is hidden.
# HELP_URL=https://docs.yourdomain.com

# ============================================
# AI Wizard (optional - enable AI features)
# ============================================
# OPENAI_API=sk-...
# OPENAI_MODEL=gpt-4o
# CLAUDE_API=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5          # generation/fill default
# CLAUDE_MODEL_PLAN=claude-opus-4-8   # deck outline/plan step (defaults to opus)
# MISTRAL_API=...
# MISTRAL_MODEL=mistral-large-latest
# DEEPSEEK_API=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# OpenAI-compatible endpoint (Ollama, Together AI, Fireworks, vLLM, etc.)
# OPENAI_COMPAT_ENDPOINT=http://localhost:11434/v1/chat/completions
# OPENAI_COMPAT_API=                  (optional - not needed for Ollama)
# OPENAI_COMPAT_MODEL=qwen2.5:72b
# OPENAI_COMPAT_LABEL=Ollama          (optional - display name in UI)

# Which configured vendor is the default (openai | claude | mistral |
# deepseek | openai-compat). Unset: first configured key wins, in that order.
# LLM_VENDOR=claude

# Persist AI validation events (unknown fields, schema issues) to
# server/logs/ai-validation, rotated daily and kept 30 days, to help improve
# prompts. On by default; set to false to disable.
# AI_VALIDATION_LOGGING=true

# ============================================
# Real-time collaboration (optional)
# ============================================
# Mounts a Yjs/Hocuspocus WebSocket endpoint at /collab and shows live
# collaborator presence in the editor. Off by default; single-user installs
# don't need it.
# COLLAB_ENABLED=true
# Phase 2 (experimental): live document edits — the Y.Doc becomes the live
# source of truth while a deck is open collaboratively, persisted server-side
# and serialized back to the deck JSON. Requires COLLAB_ENABLED.
# COLLAB_LIVE_EDITS=true

# ============================================
# Authentication (recommended for production)
# ============================================
# Set AUTH_SECRET to enable authentication (users are managed in the database;
# the AUTH_ADMIN_EMAIL user gets the admin role).
#
# Secure-by-default: the server REFUSES TO START if AUTH_SECRET is missing,
# UNLESS you explicitly opt out of auth with AUTH_ENABLED=false (or run in
# sandbox/demo mode). This prevents accidentally running wide open with
# anonymous admin access. To run intentionally without auth, set
# AUTH_ENABLED=false.
#
# AUTH_ENABLED is default-ON and only an explicit falsy token (false/0/no/off)
# disables it. Unset, blank, or unrecognized values (a typo like "fasle") all
# leave auth ENABLED — the flag never fails open on a misspelling.
#
# AUTH_SECRET must be at least 32 characters. Session tokens are HMAC-signed
# with it, so a short secret is brute-forceable/forgeable; the server refuses
# to start below the 32-char floor. If you must boot with a shorter secret
# temporarily, set AUTH_ALLOW_WEAK_SECRET=true (NOT recommended; rotate to a
# strong secret instead). Generate one with e.g. `openssl rand -base64 48`.
# AUTH_SECRET=generate-a-random-secret-here
# AUTH_ADMIN_EMAIL=admin@example.com
# AUTH_ENABLED=false   # run intentionally without auth (anonymous admin)
# AUTH_ALLOW_WEAK_SECRET=true   # escape hatch: boot with a sub-32-char secret
# SECURE_COOKIES=true
# COOKIE_DOMAIN=.yourdomain.com
# CSRF: cookie-authenticated state-changing requests must come from a same-origin
# request (Origin/Referer host must match the app Host, APP_URL, or DOMAIN). Add
# extra trusted origins here (comma-separated) if a partner site legitimately
# posts to the API with the session cookie.
# CSRF_ALLOWED_ORIGINS=https://embed.partner.com

# Development only: skip auth entirely (auto-login as admin).
# Only takes effect when NODE_ENV=development — a leftover AUTH_DEV_BYPASS in a
# staging/production (or unset-NODE_ENV) environment is ignored, so it can never
# silently grant passwordless admin outside local dev.
# NODE_ENV=development
# AUTH_DEV_BYPASS=true

# ============================================
# Single sign-on (SSO) — self-hosted, one IdP (OIDC)
# ============================================
# Point the whole install at one OIDC provider (Google Workspace, Entra ID,
# Okta, Auth0, Keycloak, ...). Users click "Sign in with SSO", authenticate at
# the IdP, and land in the same email-keyed authorization world as password /
# magic-link users. Full guide: docs/reference/sso-oidc.md
#
# The server REFUSES TO START if SSO_ENABLED=true but the OIDC settings are
# incomplete (a half-configured SSO is worse than a clear boot error).
# SSO_ENABLED=true
# SSO_PROVIDER=oidc
# OIDC_ISSUER_URL=https://login.example.com   # discovery via /.well-known/openid-configuration
# OIDC_CLIENT_ID=...
# OIDC_CLIENT_SECRET=...
# OIDC_REDIRECT_URI=https://deck.example.com/api/auth/oidc/callback
# OIDC_ALLOWED_DOMAINS=example.com            # optional: restrict to these email domains (comma-separated)
# OIDC_AUTO_PROVISION=true                    # JIT-create users on first login (default true)
# OIDC_DEFAULT_ROLE=user                      # role for provisioned users (user|admin)
# OIDC_ADMIN_GROUPS=deckyard-admins           # optional: IdP groups/roles that map to admin (comma-separated)
# SSO_ENFORCE=false                           # true = hide password + magic-link, SSO only

# ============================================
# ImageKit CDN (recommended for production)
# ============================================
# IMAGEKIT_PRIVATE_KEY=...
# IMAGEKIT_PUBLIC_KEY=...
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/youraccount
# Folder ImageKit uploads land in (normalized to a leading slash). Unset means
# uploads use ImageKit's own default folder.
# IMAGEKIT_UPLOAD_FOLDER=/deckyard
# Prefix for the per-deck tags Deckyard sets on ImageKit assets (default: deck:).
# IMAGEKIT_TAG_PREFIX=deck:
# Name of the ImageKit custom metadata field used to read/write the ALT-text
# seed. Unset means ALT seed read/write is disabled.
# IMAGEKIT_METADATA_FIELD_ALT_SEED=alt_seed
# Serve media exclusively from ImageKit: disables direct uploads and hides the
# local image library. Default: off.
# IMAGEKIT_ONLY=false

# ============================================
# Media storage (S3-compatible object storage - optional)
# ============================================
# Works with any S3-compatible store: AWS S3, MinIO, Wasabi, Backblaze B2,
# Scaleway Object Storage, ...
# Where uploaded media files are stored: auto (S3 when the S3_* keys below are
# configured, local otherwise), s3 (forced; errors if not configured), or
# local. Default: auto.
# MEDIA_STORAGE_MODE=auto
# S3 counts as configured when ACCESS_KEY, SECRET_KEY, BUCKET and ENDPOINT are set.
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_BUCKET=deckyard-media
# Endpoint of your provider. Required in s3 mode - there is no default.
# Examples: https://s3.eu-central-1.amazonaws.com, https://s3.nl-ams.scw.cloud,
# https://minio.yourdomain.com
# S3_ENDPOINT=https://s3.nl-ams.scw.cloud
# Region as your provider names it (default: nl-ams).
# S3_REGION=nl-ams
# Optional CDN or custom-domain base URL for public access to the bucket.
# Unset means the public URL is derived from S3_ENDPOINT + S3_BUCKET
# (virtual-hosted style), which requires a publicly readable bucket.
# S3_PUBLIC_URL=https://media.yourdomain.com

# --- Legacy, removed in the first release after 2026-11-01 -------------------
# The Scaleway-era names above are still read when their S3_* counterpart is
# unset, and every one that is read prints a boot warning naming its
# replacement. MEDIA_STORAGE_MODE=scaleway is the old spelling of =s3.
# For an untouched legacy install only (no S3_* core var set, no endpoint under
# either name) the endpoint is still derived as https://s3.<SCW_REGION>.scw.cloud.
# SCW_ACCESS_KEY=...
# SCW_SECRET_KEY=...
# SCW_BUCKET=deckyard-media
# SCW_REGION=nl-ams
# SCW_ENDPOINT=https://s3.nl-ams.scw.cloud
# SCW_CDN_URL=https://media.yourdomain.com

# ============================================
# Notion Integration (optional)
# ============================================
# NOTION_SECRET=...
# NOTION_FEATURE=true

# ============================================
# Live Data Sources (optional)
# ============================================
# Enable slides to connect to external data sources (Notion, CSV, Google Sheets)
# LIVE_DATA_ENABLED=true

# ============================================
# Feature flags (optional)
# ============================================
# Demo mode: disables AI features and direct uploads, and (like sandbox mode)
# lets the server boot without AUTH_SECRET. Default: off.
# DEMO_MODE=false
# AI features (kill switch even when LLM keys are configured). Default: on.
# Replaces DISABLE_AI, which is still honored with a boot warning until
# 2026-11-01 — set AI_ENABLED=false where you had DISABLE_AI=true.
# AI_ENABLED=true
# Direct file uploads (also turned off by DEMO_MODE, sandbox mode and
# IMAGEKIT_ONLY). Default: on. Replaces DISABLE_UPLOADS (honored with a boot
# warning until 2026-11-01).
# UPLOADS_ENABLED=true
# The local image library (also turned off by IMAGEKIT_ONLY). Default: on.
# Replaces DISABLE_IMAGE_LIBRARY (honored with a boot warning until 2026-11-01).
# IMAGE_LIBRARY_ENABLED=true
# Multi-organization mode ("Workspaces"): one instance holds several
# organizations that users can create and switch between. Default: off
# (single-organization mode using the default organization).
# MULTI_ORG_ENABLED=false
# Organization UUID used in single-organization mode (fallback in multi-org).
# DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
# Instance-wide kill switch for RSS/Atom/JSON feeds of published presentations;
# the user-facing gate is the per-organization setting. Default: on.
# RSS_FEED_ENABLED=true
# Comma-separated emails allowed to author raw HTML/CSS (custom-html slides).
# Admins always qualify; when unset, no non-admin qualifies. Default: unset.
# CUSTOM_HTML_EDITOR_EMAILS=designer@example.com

# ============================================
# Data retention (optional)
# ============================================
# A daily cleanup trims data that would otherwise grow without bound. Rate-limit
# accounting (api_usage_daily) is fixed at 90 days and expired share links are
# revoked every run; only the activity feed is tunable. Activity events carry
# actor emails, so they are deleted after this many days (default 180).
# ACTIVITY_RETENTION_DAYS=180

# ============================================
# Analytics (optional tuning)
# ============================================
# Interval in ms at which viewers send heartbeats (default: 30000).
# ANALYTICS_HEARTBEAT_INTERVAL_MS=30000
# Sessions with activity within this many seconds count as "active"
# (default: 60).
# ANALYTICS_ACTIVE_THRESHOLD_SECONDS=60
# Max lifetime in ms of a real-time viewer SSE connection
# (default: 3600000 = 1 hour).
# ANALYTICS_SSE_TIMEOUT_MS=3600000
# How often in ms viewer counts are pushed over SSE (default: 5000).
# ANALYTICS_SSE_UPDATE_INTERVAL_MS=5000
# Stored user-agent strings are truncated to this many characters
# (default: 500).
# ANALYTICS_MAX_USER_AGENT_LENGTH=500
# Sanity cap on reported slide indexes (default: 1000).
# ANALYTICS_MAX_SLIDE_INDEX=1000
# Seeds for the analytics-retention defaults in instance settings (the admin
# UI is the runtime source of truth): days to keep session data (default 90,
# clamped 1-365) and days before viewer IPs are anonymized (default 7,
# clamped 1-90).
# ANALYTICS_RETENTION_DAYS=90
# ANALYTICS_IP_ANONYMIZATION_DAYS=7

# ============================================
# External analytics providers (head snippets)
# ============================================
# Third-party analytics tags injected into the app shell — and nowhere else:
# a published deck and an embed are first-party-only (D56;
# docs/reference/no-third-party-origins.md). Matomo, Plausible,
# Umami and GA4 are UI-configurable per instance (Settings > Analytics); the
# env vars below are the fallback when settings leave a provider off.
# Master switch: any truthy value removes every provider tag. Default: off.
# DISABLE_ANALYTICS=false
# Include provider tags in sandbox mode. Default: off.
# ANALYTICS_ALLOW_IN_SANDBOX=false
# Escape hatch: a custom head snippet, raw or base64-encoded (B64 wins;
# env-only, not UI-configurable).
# ANALYTICS_HEAD_HTML=
# ANALYTICS_HEAD_HTML_B64=
# Google Tag Manager (env-only).
# GTM_CONTAINER_ID=GTM-XXXXXXX
# Matomo (URL + site id required as a pair).
# MATOMO_URL=https://matomo.example.com
# MATOMO_SITE_ID=1
# MATOMO_DISABLE_COOKIES=true
# MATOMO_REQUIRE_CONSENT=false
# MATOMO_TRACK_LINKS=true
# Plausible (URL only needed when self-hosting Plausible).
# PLAUSIBLE_DOMAIN=decks.example.com
# PLAUSIBLE_URL=https://plausible.example.com
# Umami (URL only needed when self-hosting Umami).
# UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# UMAMI_URL=https://umami.example.com
# Google Analytics 4.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Public SSE streams (DoS caps)
# ============================================
# Caps on the unauthenticated follow/questions/live-session event streams.
# Total concurrent SSE streams across the server (default: 2000).
# SSE_MAX_CONNECTIONS=2000
# Concurrent streams per client IP; applied only when the observed client IP
# is a real public address that distinguishes clients (default: 50).
# SSE_MAX_CONNECTIONS_PER_IP=50
# Absolute stream lifetime in ms before a force-close; EventSource clients
# reconnect automatically (default: 21600000 = 6 hours).
# SSE_MAX_LIFETIME_MS=21600000
# How long in ms after the presenter's last update a live session still counts
# as "live" (default: 900000 = 15 minutes; floor 60000).
# PRESENT_LIVE_WINDOW_MS=900000

# ============================================
# Notifications
# ============================================
# Debounce window in minutes for bundling deck-activity notifications
# (slide-adds on the same deck) into one unread notification (default: 60).
# DECK_ACTIVITY_NOTIFY_WINDOW_MIN=60

# ============================================
# Email (Brevo/Sendinblue - optional)
# ============================================
# BREVO_API_KEY=...
# BREVO_SENDER_EMAIL=noreply@yourdomain.com
# BREVO_SENDER_NAME=Deckyard

# ============================================
# Database (PostgreSQL)
# ============================================
# Deckyard runs on PostgreSQL. STORAGE_MODE defaults to `postgres`, so this
# whole block is optional:
#
# - docker compose: the stack ships a `postgres` service and the app container
#   runs on it out of the box. Nothing below needs to be set; migrations are
#   applied automatically at container start. Point DATABASE_HOST at a managed
#   database to bypass the bundled one. Do NOT set DATABASE_HOST=localhost for
#   compose: inside the container localhost is the app itself, not the database
#   (the bundled one is the host `postgres`). The entrypoint refuses to start on
#   a localhost value so a leftover host .env cannot silently point the stack at
#   itself.
# - plain `npm start` from a checkout: point the settings below at your own
#   PostgreSQL and run `npm run db:migrate` once. Here DATABASE_HOST=localhost is
#   the normal value.
#
# PostgreSQL is the only storage backend; the file backend (JSON on disk) was
# removed in 1.x. An install with existing file data imports it once with
# `npm run db:import` — Deckyard refuses to boot on an empty database while
# that data is still on disk.
#
# STORAGE_MODE=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=deckyard
# DATABASE_USER=deckyard
# DATABASE_PASSWORD=...
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
#
# DATABASE_URL, when set, is the complete connection override: host, port,
# database, user and password all come from the URL, never a mix with the
# DATABASE_* variables above. The SSL and pool knobs still apply on top.
# DATABASE_URL=postgres://user:pass@host:5432/deckyard
# Connection pool size (defaults: min 2, max 10).
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# Host port for the bundled compose database (docker-compose.local.yml only).
# Defaults to 5433 so it does not collide with a Postgres already running on
# the host at 5432.
# POSTGRES_HOST_PORT=5433

# ============================================
# Redis (optional - job queue and caching)
# ============================================
# Backs the background job queue (BullMQ) and distributed caching. Redis is
# considered configured when REDIS_URL or REDIS_HOST is set; without either,
# the server falls back to in-process alternatives.
# REDIS_URL=redis://localhost:6379
# Discrete settings, used when REDIS_URL is not set (defaults shown).
# REDIS_HOST=localhost
# REDIS_PORT=6379
# Redis password. Unset means no auth.
# REDIS_PASSWORD=...
# Redis database number (default: 0).
# REDIS_DB=0
# Set to false to explicitly disable Redis even when a URL/host is configured.
# REDIS_ENABLED=true
# Collaborator-permission cache: TTL in seconds (default 300 = 5 minutes) and
# max in-memory entries for the LRU fallback when Redis is unavailable
# (default 10000).
# PERMISSION_CACHE_TTL_SECONDS=300
# PERMISSION_CACHE_MAX_SIZE=10000

# ============================================
# Presentation limits & concurrent editing
# ============================================
# Soft limits warn the user but allow the save; hard limits block it.
# PRESENTATION_SOFT_SLIDE_LIMIT=100
# PRESENTATION_HARD_SLIDE_LIMIT=500
# PRESENTATION_SOFT_SIZE_MB=10
# PRESENTATION_HARD_SIZE_MB=50
# Maximum client staleness (in revisions) the slide-level concurrent-edit
# merge accepts; staler saves get a plain 409 and the editor's reload flow.
# Default: 10.
# MERGE_MAX_REVISION_GAP=10

# ============================================
# Stock Media (Unsplash & Giphy)
# ============================================
# UNSPLASH_ACCESS_KEY=your-unsplash-access-key
# GIPHY_API_KEY=your-giphy-api-key

# ============================================
# Sandbox mode (public throwaway playground)
# ============================================
# Turns the instance into an anonymous, self-cleaning demo (a la "try it"):
# guest sessions with an unguessable cookie, auto-cleanup after the TTL,
# watermarked exports, direct uploads and publishing off. Unsplash/Giphy stay
# on as stock sources (set the keys above). Use docker-compose.sandbox.yml,
# which wires these up. See server/config/sandbox.js and docs/ops/self-hosting.md.
# SANDBOX_MODE=1
# SANDBOX_TTL_HOURS=24
# SANDBOX_DEFAULT_THEME=editorial
# SANDBOX_COOKIE_DAYS=30
# SANDBOX_WATERMARK=Sandbox export • Created by an anonymous user
# Separate data/uploads dirs so the cleanup sweep only touches guest content.
# SANDBOX_DATA_DIR=server/data-sandbox
# SANDBOX_UPLOADS_DIR=server/uploads-sandbox
# Per-guest quotas: max decks and max total stored bytes per guest
# (defaults: 25 decks, 52428800 = 50 MB).
# SANDBOX_MAX_DECKS_PER_GUEST=25
# SANDBOX_MAX_BYTES_PER_GUEST=52428800
# Global soft ceiling in bytes for the whole presentations table; the cleanup
# loop only logs when it is exceeded. 0 or unset disables the check.
# SANDBOX_MAX_TOTAL_BYTES=0

# ============================================
# Bunny Stream (optional - for video export)
# ============================================
# Enable MP4 embedding in PPTX exports for Bunny-hosted videos.
# Find your pull zone hostname in Bunny dashboard under Stream > Video Library > Pull Zone.
# Format: vz-xxxxxx-xxx.b-cdn.net (or just the subdomain: vz-xxxxxx-xxx)
# Optional for PDF/PNG exports too: the poster still in the video placeholder
# uses this pull zone when set, and otherwise discovers it from the video's own
# Bunny play page. Setting it saves that one lookup per process.
# BUNNY_PULLZONE=vz-xxxxxx-xxx.b-cdn.net

# ============================================
# HTTPS/Domain (for Caddy reverse proxy)
# ============================================
# DOMAIN=slides.yourdomain.com
# LETSENCRYPT_EMAIL=admin@yourdomain.com
# Behind a trusted reverse proxy (Caddy, nginx), set TRUST_PROXY=true so the
# real client IP is read from X-Forwarded-For / X-Real-IP instead of the proxy's
# socket address. This is what the per-IP login brute-force throttle keys on, so
# without it every request looks like it comes from the proxy and the throttle
# treats all users as one client. Only enable it when a proxy you control sets
# those headers; a directly-exposed server must leave it off (spoofable).
# TRUST_PROXY=true
# Number of trusted reverse proxies that append to X-Forwarded-For between the
# client and the app; the client IP is taken that many hops from the right of
# the chain. Default: 1 (single proxy), minimum 1.
# TRUSTED_PROXY_COUNT=1

# ============================================
# Application URL (for outbound emails)
# ============================================
# Used in notification emails (export ready, digests, etc.)
# If not set, falls back to https://{DOMAIN} or relative URLs.
# APP_URL=https://slides.yourdomain.com
# Base URL for the analytics link in lead-notification emails. Unset means the
# link is relative.
# BASE_URL=https://slides.yourdomain.com

# ============================================
# Exports (server-rendered PDF)
# ============================================
# Timeout in ms for the headless-Chrome PDF render (setContent + page.pdf).
# Large decks with many embedded images can exceed Puppeteer's 30000ms default
# and fail with "Timed out after waiting 30000ms". Raise this if needed.
# 0 disables the cap (not recommended). Default: 120000.
# PDF_EXPORT_TIMEOUT_MS=120000
#
# Images are downsampled + recompressed (JPEG for opaque, PNG for transparent;
# SVGs/animated GIFs left alone) before being inlined, so a full-res photo does
# not drag its original pixels into the PDF. This typically shrinks exports by
# an order of magnitude. Longest edge is capped at PDF_EXPORT_IMAGE_MAX_PX
# (default 2600, a retina margin over the 1600px canvas) and opaque images are
# encoded at PDF_EXPORT_IMAGE_QUALITY (1-100, default 80). Set MAX_PX=0 or
# PDF_EXPORT_IMAGE_COMPRESSION=off to disable; compression is default-on, so
# an unrecognized toggle value leaves it on.
#
# On the rendered <img src> pass the cap is display-aware: the export measures
# how big each image is actually drawn and caps it at
# PDF_EXPORT_IMAGE_RETINA_SCALE times that size (default 2, valid range 1-4),
# never above PDF_EXPORT_IMAGE_MAX_PX. A full-bleed photo therefore keeps its
# resolution while a grid thumbnail no longer embeds at full-bleed size. Raise
# the scale if small images look soft when zoomed into the PDF.
# PDF_EXPORT_IMAGE_MAX_PX=2600
# PDF_EXPORT_IMAGE_RETINA_SCALE=2
# PDF_EXPORT_IMAGE_QUALITY=80
# PDF_EXPORT_IMAGE_COMPRESSION=on
#
# Chromium sandbox. The Docker image runs the browser as a non-root user, so a
# renderer compromise is contained without root. Chromium's own sandbox is OFF
# by default because its namespace sandbox needs syscalls that Docker's default
# seccomp profile blocks (a sandboxed launch would fail and break export). If
# you harden the runtime (e.g. run with `--cap-add=SYS_ADMIN` or a Chromium
# seccomp profile), set PUPPETEER_SANDBOX=true to re-enable it for extra
# defense-in-depth.
# PUPPETEER_SANDBOX=false
#
# Path to the Chrome/Chromium binary the export chain drives (puppeteer-core
# ships without a browser). PUPPETEER_EXECUTABLE_PATH wins over CHROME_BIN;
# when neither is set, well-known install locations are probed.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# CHROME_BIN=/usr/bin/chromium
#
# Concurrency for image embedding during export/render (default: 8).
# EXPORT_EMBED_CONCURRENCY=8
#
# Width in CSS pixels of the rasterized slide-background gradient in PDF
# exports (default 512, capped at 4096); 0 disables rasterizing and restores
# the live (slow) gradient.
# PDF_GRADIENT_RASTER_WIDTH=512
#
# Warm deck thumbnails after a save (debounced). Default: on, except under the
# node test runner; 1/true or 0/false forces it either way.
# DECK_THUMBNAIL_WARM_ON_SAVE=1

# ============================================
# MCP server (optional)
# ============================================
# Default owner email for presentations created via the Deckyard MCP server
# (stdio transport). Unset means no default owner.
# DECKYARD_MCP_OWNER_EMAIL=you@example.com

# ============================================
# Maintenance mode ("we're right back")
# ============================================
# During a restart or a migration, writes are refused with a 503 that carries
# Retry-After, open editors go read-only and pause autosave, and a banner says
# the work is kept in the browser. Reads stay open, so viewers and presenters
# are unaffected.
#
# Set this before a deploy you know will break writes (a migration that has not
# run yet). You do NOT need it for an ordinary restart: the server announces
# maintenance to connected clients on SIGTERM by itself, which is the moment
# that actually matters — the container going down is the one holding the
# connections.
# MAINTENANCE_MODE=false
#
# How long clients are told to wait before retrying, in seconds. Default: 30.
# MAINTENANCE_RETRY_AFTER_SECONDS=30
