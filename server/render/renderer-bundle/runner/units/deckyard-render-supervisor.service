[Unit]
Description=Deckyard operator render supervisor
After=local-fs.target

[Service]
Type=exec
User=root
Group=root
ExecStartPre=/usr/bin/systemd-tmpfiles --create /etc/tmpfiles.d/deckyard-render.conf
ExecStart=/opt/deckyard-render/image/bin/node /opt/deckyard-render/code/runner/index.js supervisor
Restart=on-failure
RestartSec=1
Delegate=cpu memory pids
DelegateSubgroup=manager
KillMode=control-group
TimeoutStopSec=5
MemoryMax=512M
MemorySwapMax=0
TasksMax=256
CPUAccounting=yes
UMask=0077
StandardInput=null
StandardOutput=journal
StandardError=journal
