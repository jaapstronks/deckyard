[Unit]
Description=Deckyard operator render supervisor
After=local-fs.target

[Service]
Type=exec
User=root
Group=root
ExecStartPre=/usr/bin/systemd-tmpfiles --create /etc/tmpfiles.d/deckyard-render.conf
ExecStart=/opt/deckyard-render/image/bin/node /opt/deckyard-render/code/runner/index.js supervisor
Restart=on-failure
RestartSec=1
Delegate=cpu memory pids
DelegateSubgroup=manager
KillMode=control-group
TimeoutStopSec=5
MemoryMax=1G
MemorySwapMax=0
TasksMax=256
CPUAccounting=yes
UMask=0077
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=~io_setup io_submit io_getevents io_pgetevents io_cancel io_destroy io_uring_setup io_uring_enter io_uring_register
StandardInput=null
StandardOutput=journal
StandardError=journal
