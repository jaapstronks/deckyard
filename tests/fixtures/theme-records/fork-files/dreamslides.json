{
  "id": "dreamslides",
  "label": "DreamSlides",
  "defaultTitleSlide": "title-slide",
  "assets": {
    "logo": "/assets/images/deckyard-mark.svg",
    "logoAlt": "DreamSlides",
    "payoffLogo": "/assets/images/deckyard-mark.svg",
    "payoffAlt": "DreamSlides"
  },
  "textColorLight": "#ffffff",
  "textColorDark": "#111827",
  "brandColors": ["#5b21b6", "#7c3aed", "#a78bfa", "#c4b5fd"],
  "gradient": {
    "enabled": false
  },
  "slides": {
    "card-stack-slide": {
      "colors": ["#5b21b6", "#7c3aed", "#a78bfa", "#c4b5fd"]
    }
  },
  "cssVars": {
    "--t-slide-bg-lime": "#ffffff",
    "--t-slide-bg-mist": "#f5f3ff",
    "--t-slide-bg-dark": "#ffffff",
    "--t-color-background": "#ffffff",
    "--t-color-text": "#111827",
    "--t-color-text-muted": "rgba(55, 65, 81, 0.82)",
    "--t-color-accent": "#7c3aed",
    "--t-color-accent-on-dark": "#5b21b6",
    "--t-radius": "16px",
    "--t-radius-sm": "12px",
    "--t-radius-lg": "20px",
    "--t-font-heading": "'Bricolage Grotesque', Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
    "--t-font-body": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
    "--t-font-caption": "var(--t-font-body)",
    "--t-font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
    "--t-heading-transform": "none",
    "--t-heading-weight": "700",
    "--t-color-accent-soft": "#f5f3ff",
    "--t-chart-0": "#5b21b6",
    "--t-chart-1": "#7c3aed",
    "--t-chart-2": "#a78bfa",
    "--t-chart-3": "#c4b5fd",
    "--t-chart-4": "#111827",
    "--t-chart-5": "#6b7280",
    "--t-chart-6": "#374151",
    "--t-chart-7": "#ddd6fe",
    "--t-logo-url": "url('/assets/images/deckyard-mark.svg')"
  },
  "embedFonts": [
    {
      "family": "Bricolage Grotesque",
      "path": "assets/fonts/BricolageGrotesque-700.woff2",
      "weight": 700,
      "style": "normal"
    }
  ],
  "hiddenSlideTypes": ["stock-team-overview-slide"],
  "backgroundPresets": [
    "/assets/images/backgrounds/backgroundpic-1.jpg",
    "/assets/images/backgrounds/backgroundpic-2.jpeg",
    "/assets/images/backgrounds/backgroundpic-3.jpeg",
    "/assets/images/backgrounds/backgroundpic-4.jpeg",
    "/assets/images/backgrounds/backgroundpic-5.jpeg",
    "/assets/images/backgrounds/backgroundpic-6.jpeg"
  ]
}
