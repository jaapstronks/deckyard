{
  "name": "deckyard",
  "version": "1.20.0",
  "description": "Self-hosted presentation engine for humans and AI agents (MCP-native)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaapstronks/deckyard.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-timeout=120000 'tests/**/*.test.js'",
    "test:pg": "node --test --test-concurrency=1 --test-timeout=120000 'tests/pg/**/*.pgtest.js'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:deadcode": "node scripts/lint-dead-exports.js && eslint . --config eslint.deadcode.config.js",
    "lint:deadexports": "node scripts/lint-dead-exports.js",
    "lint:deadcss": "node scripts/lint-dead-css.js",
    "audit": "node scripts/audit-codebase.js",
    "gen:slide-authoring": "node scripts/generate-slide-authoring-aggregator.js",
    "gen:slide-ai": "node scripts/generate-slide-ai-aggregator.js",
    "gen:slide-inline-edit": "node scripts/generate-slide-inline-edit-aggregator.js",
    "gen:slide-css": "node scripts/generate-slide-css-aggregators.js",
    "gen:slide-docs": "node scripts/generate-slide-type-docs.js",
    "gen:gradients": "node scripts/generate-bundled-gradients.js",
    "db:migrate": "node server/db/migrate.js up",
    "db:migrate:down": "node server/db/migrate.js down",
    "db:migrate:status": "node server/db/migrate.js status",
    "db:import": "node scripts/migrate-data-to-postgres.js",
    "i18n:audit": "node scripts/i18n-audit.js",
    "i18n:extract": "node scripts/i18n-extract.js",
    "i18n:merge": "node scripts/i18n-merge.js",
    "i18n:sync": "node scripts/i18n-sync.js",
    "i18n:validate": "node scripts/i18n-validate.js",
    "start": "node server/server.js",
    "setup": "node scripts/setup.js",
    "seed:bg-demo": "node scripts/seed-bg-contrast-demo.js",
    "capture": "node capture/run.js",
    "mcp": "node server/mcp/index.js",
    "vendor:collab": "esbuild scripts/collab-vendor-entry.js --bundle --format=esm --platform=browser --minify --legal-comments=none --banner:js='/* Vendored bundle: yjs + @hocuspocus/provider (ESM, browser). Generated by `npm run vendor:collab` - do not edit by hand. */' --outfile=client/vendor/collab.js",
    "vendor:dompurify": "node scripts/vendor-dompurify.js",
    "vendor:prism-katex": "node scripts/vendor-prism-katex.js",
    "postinstall": "node scripts/vendor-lucide.js && node scripts/vendor-dompurify.js && node scripts/vendor-prism-katex.js && node scripts/download-google-fonts.js",
    "test:ai-suite": "node --env-file=.env test-suite/runner/run.js",
    "ai-suite:fetch": "node --env-file=.env test-suite/scripts/fetch-cases.js",
    "ai-suite:parse-refs": "node test-suite/scripts/parse-reference.js",
    "ai-suite:stage": "node --env-file=.env test-suite/runner/stage.js"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.5.0",
    "dompurify": "^3.4.13",
    "feed": "^6.0.0",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "katex": "0.18.3",
    "kysely": "^0.29.4",
    "lucide-static": "^1.31.0",
    "mammoth": "^1.12.1",
    "openid-client": "^6.8.4",
    "pg": "^8.23.0",
    "prismjs": "1.30.0",
    "sharp": "^0.35.3",
    "yaml": "^2.8.2",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@hocuspocus/server": "^4.5.0",
    "bullmq": "^6.0.9",
    "crossws": "^0.4.10",
    "ioredis": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^25.5.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@eslint/js": "^10.0.1",
    "acorn": "^8.18.0",
    "es-module-lexer": "^2.3.1",
    "esbuild": "0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.9.0",
    "image-size": "file:./vendor/image-size-stub"
  },
  "overrides": {
    "image-size": "file:./vendor/image-size-stub"
  }
}
